{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@akramcode/chord": ["./packages/chord/src/index.ts"],
			"@akramcode/chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@akramcode/chord/context": ["./packages/chord/src/context/index.ts"],
			"@akramcode/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@akramcode/chord/node": ["./packages/chord/src/node.ts"],
			"@akramcode/telemetry": ["./packages/telemetry/src/index.ts"],
			"@akramcode/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@akramcode/codemode": ["./packages/codemode/src/index.ts"],
			"@akramcode/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@akramcode/codemode/source": ["./packages/codemode/src/source.ts"],
			"@akramcode/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@akramcode/mcp": ["./packages/mcp/src/index.ts"],
			"@akramcode/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@akramcode/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@akramcode/ai": ["./packages/ai/src/index.ts"],
			"@akramcode/ai/*": ["./packages/ai/src/*.ts"],
			"@akramcode/ai/dist/*": ["./packages/ai/src/*"],
			"@akramcode/providers": ["./packages/providers/src/index.ts"],
			"@akramcode/providers/oauth": ["./packages/providers/src/oauth.ts"],
			"@akramcode/providers/*": ["./packages/providers/src/*.ts", "./packages/providers/src/providers/*.ts"],
			"@akramcode/providers/dist/*": ["./packages/providers/src/*"],
			"@akramcode/durable": ["./packages/durable/src/index.ts"],
			"@akramcode/durable/testing": ["./packages/durable/src/testing/index.ts"],
			"@akramcode/durable/*": [
				"./packages/durable/src/*.ts",
				"./packages/durable/src/*/index.ts",
				"./packages/durable/src/*"
			],
			"@akramcode/agent-core": ["./packages/agent/src/index.ts"],
			"@akramcode/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@akramcode/coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@akramcode/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@akramcode/coding-agent/*": ["./packages/coding-agent/src/*"],
			"@akramcode/protocol": ["./packages/protocol/src/index.ts"],
			"@akramcode/protocol/*": ["./packages/protocol/src/*"],
			"@akramcode/client": ["./packages/client/src/index.ts"],
			"@akramcode/client/unix": ["./packages/client/src/unix.ts"],
			"@akramcode/client/*": ["./packages/client/src/*"],
			"@akramcode/server": ["./packages/server/src/index.ts"],
			"@akramcode/server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@akramcode/server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@akramcode/tui": ["./packages/tui/src/index.ts"],
			"@akramcode/tui/*": ["./packages/tui/src/*"],
			"@akramcode/agent-old": ["./packages/agent-old/src/index.ts"],
			"@akramcode/agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
