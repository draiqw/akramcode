{
	"name": "@akramcode/ai",
	"version": "1.0.29",
	"description": "Core LLM types, model registry and utilities for AkramCode",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./models": {
			"types": "./dist/models.d.ts",
			"import": "./dist/models.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		},
		"./auth/*": {
			"types": "./dist/auth/*.d.ts",
			"import": "./dist/auth/*.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"typebox": "1.3.27",
		"@akramcode/telemetry": "^1.0.29",
		"partial-json": "0.1.7"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/draiqw/akramcode.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"canvas": "3.2.3",
		"vitest": "4.1.11"
	}
}
