{
	"name": "@akramcode/protocol",
	"version": "1.0.19",
	"description": "Transport-neutral CBOR protocol for remote akramcode sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"akramcode",
		"protocol",
		"cbor",
		"binary",
		"framing"
	],
	"author": "AkramCode",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/draiqw/akramcode.git",
		"directory": "packages/protocol"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@akramcode/chord": "^1.0.19",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.11"
	}
}
